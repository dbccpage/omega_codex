import Init

/-!
# Typed rejection ideals for Woland execution attempts

AuthorityEffect: None.

This module proves a conditional, multiary quotient construction. `Profile`
models the ordered colour/schema boundary of the existing Rust
`omega_operad_theory::kernel::terms` interpreter. `Slot` selects an external
input occurrence by a prefix/suffix decomposition, not by colour lookup.

`PartialSystem` supplies typed partial substitution but does not assume or
claim the tree associativity/unit laws, symmetric actions, or a refinement of
Rust evaluation. Those realization obligations remain separate. `Seed` must
be instantiated with independently validated, immutable, scope-bound failed
attempts. This module does not establish the truth of a gate predicate from a
receipt, interpret missing evidence as a mathematical defect, or grant authority.

The generated ideal propagates rejection through active substitution. A new
repair keeps its failed predecessor in provenance, not as an active child.
The quotient forgets rejection details only in its control projection; retained
evidence is not rewritten. In a set-valued collection there is no linear sum
of ideals. Multiple gate seeds can be combined before generating this ideal.
-/

namespace Woland.GateIdeal

universe u v

/-- A runtime colour is intended to include both colour ID and schema version. -/
structure Profile (Colour : Type u) where
  inputs : List Colour
  output : Colour

/-- A valid ordered input occurrence into which the inner term can be placed. -/
structure Slot {Colour : Type u} (outer inner : Profile Colour) where
  before : List Colour
  after : List Colour
  boundary_eq : outer.inputs = before ++ [inner.output] ++ after

def Slot.result {Colour : Type u} {outer inner : Profile Colour}
    (slot : Slot outer inner) : Profile Colour :=
  ⟨slot.before ++ inner.inputs ++ slot.after, outer.output⟩

theorem Slot.result_inputs {Colour : Type u} {outer inner : Profile Colour}
    (slot : Slot outer inner) :
    slot.result.inputs = slot.before ++ inner.inputs ++ slot.after := rfl

theorem Slot.result_output {Colour : Type u} {outer inner : Profile Colour}
    (slot : Slot outer inner) : slot.result.output = outer.output := rfl

/-- A typed multiary substitution interface; operad laws are not assumed here. -/
structure PartialSystem (Colour : Type u) where
  Op : Profile Colour → Type v
  compose : {outer inner : Profile Colour} → (slot : Slot outer inner) →
    Op outer → Op inner → Op slot.result

/-- Rejection is absorbing on either operand of every well-typed substitution. -/
structure Ideal {Colour : Type u} (system : PartialSystem.{u,v} Colour) where
  rejected : {profile : Profile Colour} → system.Op profile → Prop
  outer_closed : ∀ {outer inner} (slot : Slot outer inner)
    (f : system.Op outer) (g : system.Op inner),
    rejected f → rejected (system.compose slot f g)
  inner_closed : ∀ {outer inner} (slot : Slot outer inner)
    (f : system.Op outer) (g : system.Op inner),
    rejected g → rejected (system.compose slot f g)

/-- The least hereditary family generated by fixed, bound failed attempts. -/
inductive Generated {Colour : Type u} (system : PartialSystem.{u,v} Colour)
    (seed : {profile : Profile Colour} → system.Op profile → Prop) :
    {profile : Profile Colour} → system.Op profile → Prop where
  | failed {profile} {f : system.Op profile} : seed f → Generated system seed f
  | outer {p q} (slot : Slot p q) (f : system.Op p) (g : system.Op q) :
      Generated system seed f → Generated system seed (system.compose slot f g)
  | inner {p q} (slot : Slot p q) (f : system.Op p) (g : system.Op q) :
      Generated system seed g → Generated system seed (system.compose slot f g)

def generatedIdeal {Colour : Type u} (system : PartialSystem.{u,v} Colour)
    (seed : {profile : Profile Colour} → system.Op profile → Prop) : Ideal system where
  rejected := Generated system seed
  outer_closed := Generated.outer
  inner_closed := Generated.inner

/-- No larger closure than hereditary generation is silently asserted. -/
theorem generated_minimal {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    {seed : {profile : Profile Colour} → system.Op profile → Prop}
    (target : Ideal system)
    (contains : ∀ {profile} (f : system.Op profile), seed f → target.rejected f)
    {profile} {f : system.Op profile} (failed : Generated system seed f) :
    target.rejected f := by
  induction failed with
  | failed h => exact contains _ h
  | outer slot f g _ ih => exact target.outer_closed slot f g ih
  | inner slot f g _ ih => exact target.inner_closed slot f g ih

/-- Same-profile Rees relation: keep exact terms, collapse rejected terms only. -/
def ReesRel {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) {profile} (f g : system.Op profile) : Prop :=
  f = g ∨ (ideal.rejected f ∧ ideal.rejected g)

theorem rees_refl {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) {profile} (f : system.Op profile) : ReesRel ideal f f :=
  Or.inl rfl

theorem rees_symm {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    {ideal : Ideal system} {profile} {f g : system.Op profile}
    (h : ReesRel ideal f g) : ReesRel ideal g f := by
  rcases h with h | ⟨hf, hg⟩
  · exact Or.inl h.symm
  · exact Or.inr ⟨hg, hf⟩

theorem rees_trans {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    {ideal : Ideal system} {profile} {f g h : system.Op profile}
    (fg : ReesRel ideal f g) (gh : ReesRel ideal g h) : ReesRel ideal f h := by
  rcases fg with rfl | ⟨hf, hg⟩
  · exact gh
  · rcases gh with rfl | ⟨_, hh⟩
    · exact Or.inr ⟨hf, hg⟩
    · exact Or.inr ⟨hf, hh⟩

/-- Both sides of hereditary closure are needed for representative independence. -/
theorem rees_substitution_congr {Colour : Type u}
    {system : PartialSystem.{u,v} Colour} {ideal : Ideal system}
    {outer inner} (slot : Slot outer inner)
    {f f' : system.Op outer} {g g' : system.Op inner}
    (ff' : ReesRel ideal f f') (gg' : ReesRel ideal g g') :
    ReesRel ideal (system.compose slot f g) (system.compose slot f' g') := by
  rcases ff' with rfl | ⟨hf, hf'⟩
  · rcases gg' with rfl | ⟨hg, hg'⟩
    · exact Or.inl rfl
    · exact Or.inr ⟨ideal.inner_closed slot f g hg,
        ideal.inner_closed slot f g' hg'⟩
  · exact Or.inr ⟨ideal.outer_closed slot f g hf,
      ideal.outer_closed slot f' g' hf'⟩

def reesSetoid {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) (profile : Profile Colour) : Setoid (system.Op profile) where
  r := ReesRel ideal
  iseqv := ⟨rees_refl ideal, rees_symm, rees_trans⟩

/-- Pointed completion provides a separate bottom at every typed boundary. -/
def pointed {Colour : Type u} (system : PartialSystem.{u,v} Colour) :
    PartialSystem Colour where
  Op profile := Option (system.Op profile)
  compose slot f g := match f, g with
    | some f, some g => some (system.compose slot f g)
    | _, _ => none

def pointedIdeal {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) : Ideal (pointed system) where
  rejected f := match f with
    | none => True
    | some f => ideal.rejected f
  outer_closed := by
    intro outer inner slot f g hf
    cases f with
    | none => trivial
    | some f =>
      cases g with
      | none => trivial
      | some g => exact ideal.outer_closed slot f g hf
  inner_closed := by
    intro outer inner slot f g hg
    cases f with
    | none => trivial
    | some f =>
      cases g with
      | none => trivial
      | some g => exact ideal.inner_closed slot f g hg

def Rees {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) (profile : Profile Colour) : Type v :=
  Quotient (reesSetoid (pointedIdeal ideal) profile)

def project {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) {profile} (f : system.Op profile) : Rees ideal profile :=
  Quotient.mk _ (some f)

def bottom {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) (profile : Profile Colour) : Rees ideal profile :=
  Quotient.mk _ none

/-- A well-defined substitution on the quotient, at the exact resulting profile. -/
def quotientSubstitute {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) {outer inner} (slot : Slot outer inner)
    (f : Rees ideal outer) (g : Rees ideal inner) : Rees ideal slot.result :=
  Quotient.liftOn₂ f g
    (fun a b => Quotient.mk _ ((pointed system).compose slot a b))
    (fun _ _ _ _ aa' bb' => Quotient.sound (rees_substitution_congr slot aa' bb'))

theorem project_substitution {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) {outer inner} (slot : Slot outer inner)
    (f : system.Op outer) (g : system.Op inner) :
    project ideal (system.compose slot f g) =
      quotientSubstitute ideal slot (project ideal f) (project ideal g) := rfl

theorem bottom_outer_absorbs {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) {outer inner} (slot : Slot outer inner)
    (g : Rees ideal inner) :
    quotientSubstitute ideal slot (bottom ideal outer) g = bottom ideal slot.result := by
  refine Quotient.inductionOn g ?_
  intro representative
  rfl

theorem bottom_inner_absorbs {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) {outer inner} (slot : Slot outer inner)
    (f : Rees ideal outer) :
    quotientSubstitute ideal slot f (bottom ideal inner) = bottom ideal slot.result := by
  refine Quotient.inductionOn f ?_
  intro representative
  cases representative <;> rfl

/-- Bottom means membership in this ideal, not an unspecified mathematical falsity. -/
theorem project_eq_bottom_iff {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) {profile} (f : system.Op profile) :
    project ideal f = bottom ideal profile ↔ ideal.rejected f := by
  constructor
  · intro h
    have relation := Quotient.exact h
    change some f = none ∨ (ideal.rejected f ∧ True) at relation
    rcases relation with impossible | ⟨failed, _⟩
    · cases impossible
    · exact failed
  · intro failed
    exact Quotient.sound (Or.inr ⟨failed, True.intro⟩)

theorem project_ne_bottom {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) {profile} {f : system.Op profile}
    (not_rejected : ¬ ideal.rejected f) : project ideal f ≠ bottom ideal profile :=
  fun h => not_rejected ((project_eq_bottom_iff ideal f).mp h)

/-- Outside the rejected class no two distinct attempts are merged. -/
theorem project_eq_project_iff {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) {profile} (f g : system.Op profile) :
    project ideal f = project ideal g ↔ ReesRel ideal f g := by
  constructor
  · intro h
    have relation := Quotient.exact h
    change some f = some g ∨ (ideal.rejected f ∧ ideal.rejected g) at relation
    rcases relation with equal | failed
    · exact Or.inl (Option.some.inj equal)
    · exact Or.inr failed
  · intro relation
    apply Quotient.sound
    rcases relation with rfl | failed
    · exact Or.inl rfl
    · exact Or.inr failed

/-- Keeping a nonzero identity requires this explicit disjointness obligation. -/
theorem identity_survives {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (ideal : Ideal system) (identity : (colour : Colour) → system.Op ⟨[colour], colour⟩)
    (disjoint : ∀ colour, ¬ ideal.rejected (identity colour)) (colour : Colour) :
    project ideal (identity colour) ≠ bottom ideal ⟨[colour], colour⟩ :=
  project_ne_bottom ideal (disjoint colour)

/-- An active replacement is distinct from the retained provenance collection. -/
structure RepairRevision {Colour : Type u} {system : PartialSystem.{u,v} Colour}
    (profile : Profile Colour) where
  predecessor : system.Op profile
  candidate : system.Op profile
  history : List (system.Op profile)
  retained : predecessor ∈ history

theorem repair_does_not_rewrite_rejection {Colour : Type u}
    {system : PartialSystem.{u,v} Colour} (ideal : Ideal system) {profile}
    (repair : RepairRevision (system := system) profile)
    (old_failed : ideal.rejected repair.predecessor)
    (new_not_rejected : ¬ ideal.rejected repair.candidate) :
    project ideal repair.predecessor = bottom ideal profile ∧
      project ideal repair.candidate ≠ bottom ideal profile ∧
      repair.predecessor ∈ repair.history :=
  ⟨(project_eq_bottom_iff ideal _).mpr old_failed,
    project_ne_bottom ideal new_not_rejected, repair.retained⟩

/-! A concrete failure-occurrence projection witnesses a proper, nonempty ideal.
The projection preserves append-only failure occurrences, not arbitrary Rust
tree semantics. IDs below stand for already bound occurrences; no hashing or
receipt authentication theorem is claimed. -/

structure Occurrence where
  attempt : Nat
  rejected : Bool
  deriving DecidableEq

def occurrenceSystem : PartialSystem Unit where
  Op _ := List Occurrence
  compose _ outer inner := outer ++ inner

def occurrenceIdeal : Ideal occurrenceSystem where
  rejected := fun {_} (occurrences : List Occurrence) =>
    ∃ occurrence : Occurrence, occurrence ∈ occurrences ∧ occurrence.rejected = true
  outer_closed := by
    intro outer inner slot f g h
    obtain ⟨occurrence, member, failed⟩ := h
    exact ⟨occurrence, List.mem_append.mpr (Or.inl member), failed⟩
  inner_closed := by
    intro outer inner slot f g h
    obtain ⟨occurrence, member, failed⟩ := h
    exact ⟨occurrence, List.mem_append.mpr (Or.inr member), failed⟩

def exampleProfile : Profile Unit := ⟨[()], ()⟩

theorem occurrence_ideal_nonempty :
    occurrenceIdeal.rejected (profile := exampleProfile) [⟨7, true⟩] :=
  ⟨⟨7, true⟩, by simp, rfl⟩

theorem occurrence_identity_not_rejected :
    ¬ occurrenceIdeal.rejected (profile := exampleProfile) [] := by
  intro h
  obtain ⟨occurrence, member, _⟩ := h
  cases member

/-- Only singleton bound failed occurrences are initial generators. -/
def occurrenceSeed {profile : Profile Unit} (occurrences : occurrenceSystem.Op profile) : Prop :=
  ∃ occurrence : Occurrence, occurrences = [occurrence] ∧ occurrence.rejected = true

def generatedOccurrenceIdeal : Ideal occurrenceSystem :=
  generatedIdeal occurrenceSystem occurrenceSeed

theorem generated_occurrence_retains_failure {profile : Profile Unit}
    {occurrences : occurrenceSystem.Op profile}
    (h : generatedOccurrenceIdeal.rejected occurrences) :
    occurrenceIdeal.rejected occurrences := by
  apply generated_minimal occurrenceIdeal (fun _ seed => ?_) h
  obtain ⟨occurrence, rfl, failed⟩ := seed
  exact ⟨occurrence, by simp, failed⟩

theorem generated_occurrence_nonempty :
    generatedOccurrenceIdeal.rejected (profile := exampleProfile) [⟨7, true⟩] :=
  Generated.failed ⟨⟨7, true⟩, rfl, rfl⟩

/-- The hereditary closure is proper: a new benign occurrence is not rejected. -/
theorem generated_occurrence_proper :
    ¬ generatedOccurrenceIdeal.rejected (profile := exampleProfile) [⟨8, false⟩] := by
  intro h
  obtain ⟨occurrence, member, failed⟩ := generated_occurrence_retains_failure h
  have equal : occurrence = ⟨8, false⟩ := by simpa using member
  subst occurrence
  cases failed

def exampleRepair : RepairRevision (system := occurrenceSystem) exampleProfile where
  predecessor := [⟨7, true⟩]
  candidate := [⟨8, false⟩]
  history := [[⟨7, true⟩]]
  retained := by
    change ([⟨7, true⟩] : List Occurrence) ∈ [[⟨7, true⟩]]
    exact List.Mem.head _

/-- Nonempty failed history and a nonzero new active candidate coexist. -/
theorem repaired_attempt_preserves_failed_history :
    project generatedOccurrenceIdeal exampleRepair.predecessor =
        bottom generatedOccurrenceIdeal exampleProfile ∧
      project generatedOccurrenceIdeal exampleRepair.candidate ≠
        bottom generatedOccurrenceIdeal exampleProfile ∧
      exampleRepair.predecessor ∈ exampleRepair.history :=
  repair_does_not_rewrite_rejection generatedOccurrenceIdeal exampleRepair
    generated_occurrence_nonempty generated_occurrence_proper

theorem failed_child_cannot_be_erased (slot : Slot exampleProfile exampleProfile) :
    occurrenceIdeal.rejected (occurrenceSystem.compose slot [⟨8, false⟩] [⟨7, true⟩]) :=
  occurrenceIdeal.inner_closed slot _ _ occurrence_ideal_nonempty

/-- A permitted output alone need not preserve a failed intermediate output. -/
def outputFails (operation : Nat → Nat) : Prop := operation 0 ≠ 0

theorem output_failure_not_postcomposition_closed :
    ∃ failed repair : Nat → Nat,
      outputFails failed ∧ ¬ outputFails (fun input => repair (failed input)) := by
  refine ⟨(fun _ => 1), (fun _ => 0), ?_, ?_⟩
  · exact Nat.one_ne_zero
  · intro h
    exact h rfl

#print axioms generated_minimal
#print axioms rees_substitution_congr
#print axioms project_substitution
#print axioms bottom_outer_absorbs
#print axioms bottom_inner_absorbs
#print axioms project_eq_bottom_iff
#print axioms project_eq_project_iff
#print axioms identity_survives
#print axioms repair_does_not_rewrite_rejection
#print axioms generated_occurrence_retains_failure
#print axioms generated_occurrence_nonempty
#print axioms generated_occurrence_proper
#print axioms repaired_attempt_preserves_failed_history
#print axioms output_failure_not_postcomposition_closed

end Woland.GateIdeal
